# Copy to .env for local reference only. Deplexo reads variables from the dashboard.
# Never commit real secrets.

NODE_ENV=production
PORT=3000

# Persistent mount on Deplexo. Locally, omit it to use ./data
DATA_DIR=/data

# Set to true in production behind HTTPS, false for local http testing.
COOKIE_SECURE=true

# Enables /api/admin/messages and /api/admin/backup.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=replace-with-32-random-bytes
